# ---------------------------------------------------------------------------
# CaddyWeb configuration
# Copy this file to `.env.local` (or `.env` for Docker Compose) and adjust it.
# ---------------------------------------------------------------------------

# Address of the Caddy Admin API. Server-side only, never sent to the browser.
# For a Caddy running on the same machine the default is:
CADDY_ADMIN_URL=http://localhost:2019

# Optional HTTP basic auth for the admin endpoint (e.g. when it sits behind
# a reverse proxy that enforces authentication):
# CADDY_ADMIN_USER=
# CADDY_ADMIN_PASSWORD=

# Origin header sent to the admin API. Needed when Caddy's admin endpoint
# enables enforce_origin. Defaults to http://127.0.0.1:2019.
# CADDY_ADMIN_ORIGIN=http://127.0.0.1:2019

# Ports used when CaddyWeb has to create a new Caddy HTTP server.
# Set these to 8080/8443 for local testing without root privileges.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Database (MySQL / MariaDB) ---------------------------------------------
# Either use the setup wizard at /setup (recommended) or configure the
# connection with environment variables. Environment variables take precedence
# over the settings saved by the wizard.
#
# DATABASE_URL=mysql://caddyweb:password@mysql:3306/caddyweb
#
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=caddyweb
# DB_USER=caddyweb
# DB_PASSWORD=
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true
#
# Directory for database.json (encrypted DB credentials). In Docker the image
# uses /app/data and Compose mounts a named volume there.
CADDYWEB_CONFIG_DIR=./data

# Base domain used by the subdomain API when only `subdomain` is provided.
# CADDYWEB_BASE_DOMAIN=example.com

# --- Panel login (required) -------------------------------------------------
# The panel has no open mode. Without APP_PASSWORD it stays locked and the
# login page shows setup instructions.
APP_USERNAME=admin
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Use a long random string:
#   openssl rand -hex 32
# If omitted, APP_PASSWORD is used as the signing secret.
AUTH_SECRET=

# Force the Secure cookie flag. When false, HTTPS is auto-detected from the
# request / X-Forwarded-Proto header.
COOKIE_SECURE=false

# --- Single sign-on (OIDC / OAuth2) — optional ------------------------------
# Prefer configuring OAuth in Settings → Single sign-on. These environment
# values are the initial/fallback configuration; database settings override
# them after you save the form. Password login always remains enabled.
#
# Authentik example issuer (keep the trailing slash):
# OIDC_ISSUER_URL=https://auth.example.com/application/o/caddyweb/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
# OIDC_SCOPES=openid profile email
#
# Optional allowlists (comma separated). Access is granted when the account
# matches a user OR a group. Leave both empty to allow any IdP user.
# OIDC_ALLOWED_USERS=you@example.com,other@example.com
# OIDC_ALLOWED_GROUPS=caddy-admins
#
# Token endpoint auth: basic (default) or post.
# OIDC_TOKEN_AUTH_METHOD=basic
#
# Public URL of the panel. Recommended behind a reverse proxy; used to build
# the OAuth callback URL when OIDC_REDIRECT_URI is not set.
# APP_URL=https://caddy.example.com
# OIDC_REDIRECT_URI=https://caddy.example.com/api/auth/oauth/callback

# --- SMTP (optional; configure in Settings → SMTP) --------------------------
# Environment values are a fallback; dashboard settings override them.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=caddyweb@example.com
# SMTP_FROM_NAME=CaddyWeb
# SMTP_REPLY_TO=
# SMTP_REJECT_UNAUTHORIZED=true

# --- Docker Compose only ----------------------------------------------------
# The container listens on 18080. This is the host port mapped by compose.
CADDYWEB_PORT=18080
